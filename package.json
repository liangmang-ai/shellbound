{
  "name": "shellbound-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "原创鸡蛋角色波次射击游戏，支持 Web 和微信小游戏",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
