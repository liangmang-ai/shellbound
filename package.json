    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "test:coop": "node scripts/smoke-coop.mjs"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1"
  },
  "engines": { "node": ">=20" }
}
